<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Cedric-Belin.fr</Company>
		<Copyright>© Cédric Belin</Copyright>
		<Description>Prevent comment spam using the Akismet service.</Description>
		<Product>Akismet for PowerShell</Product>
		<Version>2026.12.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AssemblyName>Belin.Akismet.PowerShell</AssemblyName>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../Binaries</OutDir>
		<RootNamespace>Belin.Akismet</RootNamespace>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(RootNamespace).Tests" />
		<PackageReference Update="FSharp.Core" Version="10.1.403" />
		<PackageReference Include="Belin.Akismet" Version="2026.12.0" />
		<PackageReference Include="System.Management.Automation" Version="7.6.9" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Validation.fs" />
		<Compile Include="Author.fs" />
		<Compile Include="Blog.fs" />
		<Compile Include="Client.fs" />
		<Compile Include="Comment.fs" />
	</ItemGroup>
</Project>
